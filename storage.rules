rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.get('role', '') == 'admin'; }
    /** 학교 권한: 승인된 담당 교사(claim schoolId) 또는 예전 학교 계정({id}@csat-cast.app) */
    function isSchool(code) {
      return request.auth != null
        && (request.auth.token.get('schoolId', '') == code
          || request.auth.token.get('email', '') == code + '@csat-cast.app');
    }
    /** 승인된 사용자 (승인 전 구글 계정은 음원을 받을 수 없다) */
    function isMember() {
      return isAdmin()
        || (request.auth != null && (request.auth.token.get('schoolId', '') != ''
          || request.auth.token.get('email', '').matches('.*@csat-cast[.]app$')));
    }

    // 평가원 기본 음원: 승인된 시험장·관리자만 읽기, 업로드는 scripts/upload-audio.ts(서비스 계정)로만
    match /builtin/audio/{file} {
      allow read: if isMember();
      allow write: if false;
    }

    // 학교별 추가 음원: 자기 학교만, mp3/wav, 20MB 이하
    match /schools/{code}/assets/{file} {
      allow read: if isSchool(code) || isAdmin();
      allow create, update: if (isSchool(code) || isAdmin())
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('audio/(mpeg|mp3|wav|x-wav)');
      // 삭제 요청에는 request.resource가 없으므로 따로 허용
      allow delete: if isSchool(code) || isAdmin();
    }
  }
}
